# AutoTime local environment example.
# Copy to .env.local for local development. Never commit real values.

# Cloud sync stays off until founder validation and Supabase RLS checks pass.
NEXT_PUBLIC_AUTOTIME_ENV=development
NEXT_PUBLIC_AUTOTIME_CLOUD_SYNC_ENABLED=false

# Supabase project settings for the post-MVP cloud sync track.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Never expose these in client code.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
RESEND_API_KEY=

# Local/browser-test auth bypass. Never enable in production.
AUTOTIME_TEST_AUTH_ENABLED=false
AUTOTIME_TEST_USER_EMAIL=agent-browser@autotime.test
AUTOTIME_TEST_USER_ID=00000000-0000-4000-8000-000000000001
AUTOTIME_TEST_USER_PLAN=free

# Comma-separated internal users who can access /admin and /diagnostics.
AUTOTIME_ADMIN_EMAILS=your-private-admin-email@example.com

# Public billing, app URL and consent-gated analytics settings.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=https://autotime-eu-apply.vercel.app
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
