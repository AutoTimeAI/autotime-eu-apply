# AutoTime local environment example.
# Copy to .env.local for local development. Never commit real values.

# Cloud sync stays off until founder validation and Supabase RLS checks pass.
NEXT_PUBLIC_AUTOTIME_ENV=development
NEXT_PUBLIC_AUTOTIME_CLOUD_SYNC_ENABLED=false

# Supabase project settings for the post-MVP cloud sync track.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Never expose these in client code.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Role Pathways uses a server-only OpenAI-compatible NVIDIA NIM endpoint.
ROLE_PATHWAYS_AI_MODE=mock
INTERVIEW_PREP_AI_MODE=mock
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
RESEND_API_KEY=

# Local/browser-test auth bypass. Never enable in production.
AUTOTIME_TEST_AUTH_ENABLED=false
AUTOTIME_TEST_USER_EMAIL=agent-browser@autotime.test
AUTOTIME_TEST_USER_ID=00000000-0000-4000-8000-000000000001
AUTOTIME_TEST_USER_PLAN=free

# Comma-separated internal users who can access /admin and /diagnostics.

# Public billing, app URL and consent-gated analytics settings.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=https://autotime-eu-apply.vercel.app
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# Optional Sentry error monitoring, tracing, session replay and source maps.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
EURES_PARTNER_API_URL=
EURES_PARTNER_API_TOKEN=
JOB_SYNC_QUERIES=software engineer,data engineer
JOB_SYNC_COUNTRIES=gb,ie,de,nl,fr
JOB_SYNC_JOOBLE_LOCATION=European Union
CRON_SECRET=
