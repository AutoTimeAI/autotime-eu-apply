# AutoTime local development environment template.
# Copy to .env.local. Never commit real values.

NEXT_PUBLIC_AUTOTIME_ENV=development
NEXT_PUBLIC_AUTOTIME_CLOUD_SYNC_ENABLED=false

# Use a dedicated Supabase development project, not production.
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-dev-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-key

# Use Stripe test mode keys and test price IDs locally.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_local_key
STRIPE_SECRET_KEY=sk_test_your_local_key
STRIPE_WEBHOOK_SECRET=whsec_your_local_stripe_cli_or_test_endpoint_secret
STRIPE_PRO_MONTHLY_PRICE_ID=price_test_monthly
STRIPE_PRO_ANNUAL_PRICE_ID=price_test_annual

# Local app URL for OAuth callbacks, Stripe return URLs, and auth redirects.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Server-side integrations. Use dev/test credentials locally.
OPENAI_API_KEY=your-dev-openai-key
RESEND_API_KEY=your-dev-resend-key

# Local/browser-test auth bypass. Never enable in production.
AUTOTIME_TEST_AUTH_ENABLED=false
AUTOTIME_TEST_USER_EMAIL=agent-browser@autotime.test
AUTOTIME_TEST_USER_ID=00000000-0000-4000-8000-000000000001
AUTOTIME_TEST_USER_PLAN=free

# Comma-separated internal users who can access /diagnostics.
AUTOTIME_ADMIN_EMAILS=founder@example.com

# Optional analytics. Leave blank locally unless testing analytics consent.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
