# AutoTime production environment template.
# Set these in Vercel Production or your production secret manager.
# Never copy production values into .env.local.

NEXT_PUBLIC_AUTOTIME_ENV=production
NEXT_PUBLIC_AUTOTIME_CLOUD_SYNC_ENABLED=true

# Cloud sync for Jobs/Applications (issue #29). Enables /api/sync/job-workflow
# and JobApplicationWorkspace's background sync to the job_workflow_* tables.
# Not yet verified against a live Supabase project - test manually before
# enabling in production.
AUTOTIME_JOB_WORKFLOW_SERVER_SYNC_ENABLED=false

# Cloud sync for Interviews (issue #29). Enables /api/sync/interviews and
# InterviewsWorkspace's background sync to the interview_* tables. Independent
# of the Jobs/Applications flag above so each can be rolled out separately.
# Not yet verified against a live Supabase project - test manually before
# enabling in production.
AUTOTIME_INTERVIEW_WORKFLOW_SERVER_SYNC_ENABLED=false

# Use the production Supabase project only.
NEXT_PUBLIC_SUPABASE_URL=https://your-prod-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-prod-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-prod-service-role-key

# Use Stripe live mode keys and live price IDs only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_production_key
STRIPE_SECRET_KEY=sk_live_your_production_key
STRIPE_WEBHOOK_SECRET=whsec_your_production_endpoint_secret
STRIPE_PRO_MONTHLY_PRICE_ID=price_live_monthly
STRIPE_PRO_QUARTERLY_PRICE_ID=price_live_quarterly
STRIPE_AI_CREDIT_PACK_PRICE_ID=price_live_credit_pack

NEXT_PUBLIC_APP_URL=https://autotime-eu-apply.vercel.app

OPENAI_API_KEY=your-production-openai-key
RESEND_API_KEY=your-production-resend-key

# Shared secret between the web app and the apps/analytics Python service
# (routed at /analytics per vercel.json). The analytics service is reachable
# directly at a public URL and cannot validate a Supabase session itself, so
# it requires this header on every request; only the web app's own
# /api/analytics/evidence-outcomes route (which authenticates the caller
# first) knows it. Generate a long random value, set it once in Vercel for
# both the web and analytics services.
ANALYTICS_INTERNAL_SECRET=your-long-random-analytics-secret

# Admin access (/admin) is not controlled by an env var: it's granted by
# inserting a row into the admin_memberships table for a specific Supabase
# auth user UUID. See docs/admin-owner-bootstrap.md.

# QA test-account session bootstrap (see docs/qa-test-account.md).
# QA_SESSION_BOOTSTRAP_SECRET is a long random secret, generated once and
# stored only in Vercel — never commit a real value. Rotate it by generating
# a new secret and updating this env var; no user password exists to reset.
QA_SESSION_BOOTSTRAP_SECRET=your-long-random-bootstrap-secret
QA_TEST_ACCOUNT_USER_ID=uuid-of-the-qa-test-auth-user

NEXT_PUBLIC_POSTHOG_KEY=your-production-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# Sentry monitoring. Set in Vercel; SENTRY_AUTH_TOKEN is server/build only.
NEXT_PUBLIC_SENTRY_DSN=your-production-sentry-dsn
SENTRY_DSN=your-production-sentry-dsn
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
