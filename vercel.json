{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "services": {
    "web": {
      "root": "apps/web/"
    },
    "analytics": {
      "root": "apps/analytics/",
      "entrypoint": "main:app",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    { "source": "/analytics/(.*)", "destination": { "service": "analytics" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
