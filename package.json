{
  "name": "autotime-eu-apply",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "build": "pnpm build:extension",
    "dev:web": "pnpm --filter web dev",
    "dev:web:reset": "powershell -ExecutionPolicy Bypass -File scripts/start-web-preview.ps1",
    "preview:web": "powershell -ExecutionPolicy Bypass -File scripts/start-web-preview.ps1 -Mode production",
    "dev:extension": "pnpm --filter extension dev",
    "build:web": "pnpm --filter web build",
    "build:extension": "pnpm --filter extension build",
    "lint": "pnpm -r lint",
    "release:check": "node scripts/release-check.mjs",
    "market:ready:gate": "node scripts/market-ready-gate.mjs",
    "market:ready:automated": "node scripts/market-ready-gate.mjs --run-automated",
    "validation:new": "node scripts/validation-run.mjs",
    "test:validation-run": "node scripts/validation-run.test.mjs",
    "test:market-ready-gate": "node scripts/market-ready-gate.test.mjs",
    "test:production-hardening": "node scripts/production-hardening.test.mjs",
    "test:country-fit": "node --experimental-strip-types scripts/country-fit-model.test.mjs",
    "test:role-pathways": "node --experimental-strip-types scripts/role-pathways.test.mjs",
    "test:role-pathways-persistence": "node --experimental-strip-types --test scripts/role-pathways-persistence.test.mjs",
    "test:phase-3a-readiness": "node --experimental-strip-types scripts/phase-3a-readiness.test.mjs",
    "test:phase-3b-workflow": "node --experimental-strip-types scripts/phase-3b-workflow.test.mjs",
    "test:phase-3c-interviews": "node --experimental-strip-types scripts/phase-3c-interviews.test.mjs",
    "test:job-workflow-migration-safety": "node --experimental-strip-types --test scripts/job-workflow-migration-safety.test.mjs",
    "test:job-workflow-migrations:local": "powershell -ExecutionPolicy Bypass -File scripts/run-local-job-workflow-migration-test.ps1",
    "test:job-workflow-sync": "node --experimental-strip-types --test scripts/job-workflow-sync.test.mjs",
    "test:interview-workflow-sync": "node --experimental-strip-types --test scripts/interview-workflow-sync.test.mjs",
    "test:admin-foundation": "node --experimental-strip-types scripts/admin-foundation.test.mjs",
    "test:job-aggregation": "node --experimental-strip-types scripts/job-aggregation.test.mjs",
    "test:ai-quality": "tsx --conditions=react-server scripts/ai-quality-evaluation.test.mjs",
    "test:admin-migrations:local": "powershell -ExecutionPolicy Bypass -File scripts/run-local-admin-migration-test.ps1",
    "test:admin-bundle-canary": "node scripts/admin-client-bundle-canary.mjs",
    "test:mvp:python": "python scripts/autotime_mvp_test_runner.py",
    "test:mvp:coverage": "node scripts/mvp-test-coverage.mjs",
    "smoke:web": "node --use-system-ca scripts/smoke-web-dashboard.mjs",
    "test:smoke:web:unit": "node scripts/smoke-web-dashboard.test.mjs",
    "test:smoke:web": "pnpm smoke:web",
    "env:doctor": "node scripts/env-doctor.mjs",
    "env:doctor:local": "node scripts/env-doctor.mjs --local",
    "env:doctor:production": "node scripts/env-doctor.mjs --production",
    "test:web:cloud-sync": "node --experimental-strip-types apps/web/tests/cloud-sync.test.mjs",
    "test:web:interview": "node --experimental-strip-types apps/web/tests/interview-prep.test.mjs",
    "test:web:sentry-privacy": "node --experimental-strip-types apps/web/tests/sentry-privacy.test.mjs",
    "test:web:dashboard-content-snapshot": "node --experimental-strip-types apps/web/tests/dashboard-content-snapshot.test.mjs",
    "test:web:auth-error-messages": "node --experimental-strip-types apps/web/tests/auth-error-messages.test.mjs",
    "test:web:docx-cv": "node --experimental-strip-types apps/web/tests/docx-cv.test.mjs",
    "test:web:safe-redirect-path": "node --experimental-strip-types apps/web/tests/safe-redirect-path.test.mjs",
    "test:web:admin-users-pagination": "node --experimental-strip-types apps/web/tests/admin-users-pagination.test.mjs",
    "test:web:account-export": "node --experimental-strip-types apps/web/tests/account-export.test.mjs",
    "test:web:image-signature": "node --experimental-strip-types apps/web/tests/image-signature.test.mjs",
    "test:web:linkedin-import": "node --experimental-strip-types apps/web/tests/linkedin-import.test.mjs",
    "test:web:request-ip": "node --experimental-strip-types apps/web/tests/request-ip.test.mjs",
    "test:web:portfolio-ssrf": "node --experimental-strip-types apps/web/tests/portfolio-ssrf.test.mjs",
    "test:web:role-intelligence-nvidia": "tsx --conditions=react-server apps/web/tests/role-intelligence-nvidia.test.mjs",
    "test:web:environment-boundaries": "node --conditions=react-server --experimental-strip-types apps/web/tests/environment-boundaries.test.mjs",
    "test:web:outreach-contacts": "node --experimental-strip-types --test apps/web/tests/outreach-contact-import.test.mjs",
    "test:v2:ai-live": "node --experimental-strip-types scripts/v2-live-ai-interview-check.mjs",
    "test:v2:ats-live": "node --experimental-strip-types scripts/v2-live-ats-validation.mjs",
    "test:mvp": "node scripts/mvp-automation-toolkit.mjs",
    "test": "pnpm test:unit",
    "test:unit": "pnpm --filter extension test && pnpm test:web:outreach-contacts && pnpm test:role-pathways && pnpm test:role-pathways-persistence && pnpm test:phase-3a-readiness && pnpm test:phase-3b-workflow && pnpm test:phase-3c-interviews && pnpm test:job-workflow-migration-safety && pnpm test:job-workflow-sync && pnpm test:interview-workflow-sync && pnpm test:admin-foundation && pnpm test:validation-run && pnpm test:market-ready-gate && pnpm test:production-hardening && pnpm test:country-fit && pnpm test:smoke:web:unit && pnpm test:web:cloud-sync && pnpm test:web:interview && pnpm test:web:sentry-privacy && pnpm test:web:dashboard-content-snapshot && pnpm test:web:auth-error-messages && pnpm test:web:safe-redirect-path && pnpm test:web:account-export && pnpm test:web:image-signature && pnpm test:web:linkedin-import && pnpm test:web:admin-users-pagination && pnpm test:web:request-ip && pnpm test:web:docx-cv && pnpm test:web:portfolio-ssrf && pnpm test:web:role-intelligence-nvidia && pnpm test:web:environment-boundaries && pnpm test:ai-quality && pnpm test:mvp:coverage",
    "test:e2e": "playwright test",
    "test:e2e:core": "playwright test tests/e2e/34-core-journeys.spec.ts",
    "test:e2e:production": "playwright test tests/e2e/production",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:lighthouse": "pnpm build:web && lhci autorun",
    "test:lighthouse:dashboard": "node scripts/lighthouse-dashboard.mjs",
    "test:all": "pnpm lint && pnpm typecheck && pnpm build && pnpm build:web && pnpm test:e2e",
    "typecheck": "pnpm -r typecheck"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.53.1",
    "next": "^16.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@supabase/supabase-js": "^2.105.3",
    "checkly": "^8.21.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "9.38.0",
    "lighthouse": "^13.4.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.2"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "18.3.28",
      "@types/react-dom": "18.3.7",
      "react": "18.2.0",
      "react-dom": "18.2.0",
      "tmp": "^0.2.6",
      "vite": "^8.0.16",
      "ws": "^8.21.0",
      "protobufjs": "^7.6.1",
      "uuid": "^11.1.1",
      "shell-quote": "^1.9.0",
      "adm-zip": "^0.6.0",
      "fast-uri": "^3.1.4",
      "postcss": "^8.5.23",
      "nanoid": "^3.3.16",
      "js-yaml": "^4.3.0",
      "esbuild": "^0.28.1",
      "dompurify": "^3.4.12",
      "@opentelemetry/core": "^2.8.0",
      "@babel/core": "^7.29.6",
      "minimatch@3>brace-expansion": "^1.1.16",
      "brace-expansion": "^5.0.6"
    }
  }
}
